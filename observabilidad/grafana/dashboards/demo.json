    {
      "type": "table",
      "title": "Tarjetas de la clase (buscá la tuya)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "description": "Las tarjetas nuevas aparecen arriba. Cada celular tiene su tarjeta, con el número de fantasía que ve en su pantalla. El estado es el que observaron sus compras: 'en revisión' = el motor detectó fraude y el bloqueo viene en camino por el camino frío (Kafka); 'bloqueada' = una compra ya dio BLACKLIST.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tarjeta, estado) (drts_demo_tarjeta_compras)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (tarjeta, estado) (drts_demo_tarjeta_fraudes)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (tarjeta, estado) (drts_demo_tarjeta_alta_ms)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "entorno": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "tarjeta": "Tarjeta",
              "estado": "Estado",
              "Value #A": "Compras",
              "Value #B": "Fraudes detectados",
              "Value #C": "Primera compra"
            },
            "indexByName": {
              "tarjeta": 0,
              "estado": 1,
              "Value #C": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Primera compra",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "activa": {
                        "color": "green",
                        "index": 0,
                        "text": "🟢 activa"
                      },
                      "en revisión": {
                        "color": "orange",
                        "index": 1,
                        "text": "🟠 en revisión"
                      },
                      "bloqueada": {
                        "color": "dark-red",
                        "index": 2,
                        "text": "🔒 bloqueada"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tarjeta"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Primera compra"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
